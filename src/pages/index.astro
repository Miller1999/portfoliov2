---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Miller Arias | Software Engineer"
  bodyClass="bg-neutral-950 text-neutral-50 min-h-screen p-4 md:p-8 font-sans selection:bg-cyan-500 selection:text-white"
>
  <main class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 auto-rows-[minmax(240px,auto)]">
      <article class="md:col-span-2 md:row-span-2 lg:col-span-2 lg:row-span-2 bg-neutral-900 rounded-3xl p-8 border border-neutral-800 flex flex-col justify-center transition-transform hover:scale-[1.01] duration-300">
        <p class="text-cyan-400 font-mono text-sm mb-4">Hola, soy</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 tracking-tight">
          Miller Arias
        </h1>
        <p class="text-neutral-400 text-lg md:text-xl leading-relaxed">
          Electronic Engineer & Full Stack Developer especializado en
          aplicaciones modernas con React, GraphQL y Go.
        </p>
      </article>

      <a
        href="/experiencia/devup"
        transition:name="card-status"
        class="bg-neutral-900 rounded-3xl p-6 pt-14 border border-neutral-800 flex flex-col justify-center items-center text-center relative overflow-hidden group hover:border-neutral-700 transition active:scale-[0.99] block decoration-none text-current"
      >
        <div class="absolute top-4 right-4 flex items-center gap-2 bg-neutral-950/50 px-3 py-1 rounded-full border border-neutral-800 max-w-[calc(100%-2rem)]">
          <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          <span class="text-[10px] font-mono text-neutral-400 uppercase tracking-wider truncate">
            Disponible
          </span>
        </div>
        <h2 class="text-sm font-mono text-neutral-500 uppercase tracking-wider mb-2">
          Status
        </h2>
        <p class="text-base font-semibold text-neutral-200 px-2">
          Full Stack Developer en Devup Consulting SAS
        </p>
        <p class="text-xs text-neutral-500 mt-2 flex items-center gap-1">
          <span aria-hidden="true">📍</span> Bogotá, Colombia
        </p>
      </a>

      <a
        href="/contacto"
        transition:name="card-contacto"
        class="bg-neutral-900 rounded-3xl p-6 border border-neutral-800 flex flex-col justify-center items-center group hover:bg-neutral-800/50 hover:border-cyan-500/30 transition active:scale-[0.99] duration-300 block decoration-none text-current"
      >
        <h2 class="text-2xl font-bold mb-2 text-neutral-200">Contacto</h2>
        <p class="text-neutral-400 group-hover:text-cyan-400 transition-colors text-sm font-medium">
          ¿Escribimos código? →
        </p>
      </a>

      <a
        href="/educacion"
        transition:name="card-educacion"
        class="md:col-span-1 lg:col-span-2 bg-neutral-900 rounded-3xl p-6 border border-neutral-800 flex flex-col justify-center group hover:border-neutral-700 transition active:scale-[0.99] block decoration-none text-current"
      >
        <h2 class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-4 group-hover:text-cyan-300 transition-colors">
          Educación & Certificaciones →
        </h2>
        <div class="space-y-4">
          <div>
            <div class="flex justify-between items-start gap-2">
              <h3 class="text-sm font-semibold text-neutral-200">
                Ingeniería Electrónica
              </h3>
              <span class="text-[10px] bg-neutral-800 px-2 py-0.5 rounded text-neutral-400 font-mono shrink-0">
                En curso
              </span>
            </div>
            <p class="text-xs text-neutral-500">
              Universidad Nacional de Colombia
            </p>
          </div>
        </div>
      </a>

      <a
        href="/experiencia"
        transition:name="card-experiencia"
        class="md:col-span-3 lg:col-span-4 bg-neutral-900 rounded-3xl p-6 md:p-8 border border-neutral-800 group hover:border-cyan-500/30 transition active:scale-[0.99] relative flex flex-col justify-center block decoration-none text-current"
      >
        <div class="absolute top-6 right-6 md:top-8 md:right-8 opacity-0 group-hover:opacity-100 transition-opacity hidden md:block">
          <span class="bg-neutral-800 text-cyan-400 text-xs px-3 py-1 rounded-full flex items-center gap-2">
            Ver historial completo <span class="text-lg">↗</span>
          </span>
        </div>
        <h2 class="text-2xl font-bold mb-6 text-neutral-200">
          Experiencia Laboral
        </h2>
        <div class="border-l-2 border-neutral-800 pl-4 md:pl-6 relative">
          <div class="absolute w-3 h-3 bg-cyan-500 rounded-full -left-[7px] top-1.5 shadow-[0_0_10px_rgba(6,182,212,0.5)]"></div>
          <div class="flex flex-col md:flex-row md:items-baseline gap-1 md:gap-4 mb-1">
            <h3 class="text-xl font-semibold text-neutral-100">
              Full Stack Developer
            </h3>
            <span class="text-neutral-500 text-sm font-mono">
              Feb 2026 - Presente
            </span>
          </div>
          <p class="text-cyan-400 text-sm mb-3 font-medium">
            Devup Consulting SAS
          </p>
          <p class="text-neutral-400 text-sm md:text-base leading-relaxed line-clamp-2">
            Desarrollo en plataforma open-source de telecomunicaciones.
            Implementación de servicios backend en <strong>Go</strong> y
            frontend en <strong>React</strong>.
          </p>
        </div>
      </a>

      <a
        href="/proyectos/edge-ai-tutor"
        transition:name="card-project-edge"
        class="md:col-span-2 lg:col-span-2 bg-neutral-900 rounded-3xl p-6 border border-neutral-800 flex flex-col justify-between group hover:border-neutral-700 transition active:scale-[0.99] block decoration-none text-current"
      >
        <div>
          <div class="flex justify-between items-start mb-2">
            <h2 class="text-xl font-bold text-neutral-100">
              Edge AI Tutor Sandbox
            </h2>
            <span class="text-[10px] font-mono text-cyan-400 border border-cyan-500/20 px-2 py-0.5 rounded-full bg-cyan-500/5">
              RAG Architecture
            </span>
          </div>
          <p class="text-neutral-400 text-sm leading-relaxed line-clamp-3">
            Arquitectura híbrida de IA generativa local y RAG para evaluación
            automatizada.
          </p>
        </div>
        <div class="flex gap-1.5 flex-wrap mt-4">
          <span class="px-2.5 py-0.5 bg-neutral-800 rounded-md text-[11px] text-neutral-300 font-mono">
            FastAPI
          </span>
          <span class="px-2.5 py-0.5 bg-neutral-800 rounded-md text-[11px] text-neutral-300 font-mono">
            Ollama
          </span>
        </div>
      </a>

      <a
        href="/proyectos/appointment-api"
        transition:name="card-project-appointment"
        class="md:col-span-1 lg:col-span-2 bg-neutral-900 rounded-3xl p-6 border border-neutral-800 flex flex-col justify-between group hover:border-neutral-700 transition active:scale-[0.99] block decoration-none text-current"
      >
        <div>
          <div class="flex justify-between items-start mb-2">
            <h2 class="text-xl font-bold text-neutral-100">
              Appointment Management API
            </h2>
            <span class="text-[10px] font-mono text-purple-400 border border-purple-500/20 px-2 py-0.5 rounded-full bg-purple-500/5">
              Full Stack
            </span>
          </div>
          <p class="text-neutral-400 text-sm leading-relaxed line-clamp-3">
            Sistema robusto de gestión de citas médicas con arquitectura
            desacoplada.
          </p>
        </div>
        <div class="flex gap-1.5 flex-wrap mt-4">
          <span class="px-2.5 py-0.5 bg-neutral-800 rounded-md text-[11px] text-neutral-300 font-mono">
            ASP.NET Core
          </span>
          <span class="px-2.5 py-0.5 bg-neutral-800 rounded-md text-[11px] text-neutral-300 font-mono">
            React
          </span>
        </div>
      </a>

      <article class="md:col-span-2 lg:col-span-2 bg-neutral-900 rounded-3xl p-6 border border-neutral-800 flex flex-col justify-center">
        <h2 class="text-xs font-mono text-neutral-500 uppercase tracking-wider mb-3">
          Tech Stack más usado
        </h2>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-neutral-950 border border-neutral-800 rounded-full text-xs text-neutral-200 font-medium">
            Go (Golang)
          </span>
          <span class="px-3 py-1 bg-neutral-950 border border-neutral-800 rounded-full text-xs text-neutral-200 font-medium">
            TypeScript
          </span>
          <span class="px-3 py-1 bg-neutral-950 border border-neutral-800 rounded-full text-xs text-neutral-200 font-medium">
            React.js
          </span>
          <span class="px-3 py-1 bg-neutral-950 border border-neutral-800 rounded-full text-xs text-neutral-200 font-medium">
            GraphQL
          </span>
        </div>
      </article>

      <article class="md:col-span-1 lg:col-span-2 bg-neutral-900 rounded-3xl p-6 border border-neutral-800 flex flex-col justify-center">
        <h2 class="text-xs font-mono text-neutral-500 uppercase tracking-wider mb-3">
          Idiomas
        </h2>
        <div class="grid grid-cols-3 gap-2 text-center text-xs font-mono">
          <div class="bg-neutral-950 p-2 rounded-xl border border-neutral-800/40">
            <span class="block text-neutral-200 font-semibold">Español</span>
            <span class="text-[10px] text-neutral-500">Nativo</span>
          </div>
          <div class="bg-neutral-950 p-2 rounded-xl border border-neutral-800/40">
            <span class="block text-cyan-400 font-semibold">English</span>
            <span class="text-[10px] text-neutral-400">C1</span>
          </div>
          <div class="bg-neutral-950 p-2 rounded-xl border border-neutral-800/40">
            <span class="block text-neutral-300 font-semibold">Deutsch</span>
            <span class="text-[10px] text-neutral-500">A2</span>
          </div>
        </div>
      </article>
      <a
        href="https://github.com/Miller1999"
        target="_blank"
        rel="noopener noreferrer"
        class="lg:col-span-1 bg-neutral-900 hover:bg-neutral-800 rounded-3xl p-6 border border-neutral-800 hover:border-neutral-700 flex flex-col items-center justify-center transition active:scale-[0.99] group block decoration-none text-current"
      >
        <span class="text-2xl mb-2" aria-hidden="true">
          🐙
        </span>
        <span class="text-sm font-semibold text-neutral-200 group-hover:text-white">
          GitHub
        </span>
      </a>

      <a
        href="https://www.linkedin.com/in/miller-javier-arias-quintero/?locale=en-US"
        target="_blank"
        rel="noopener noreferrer"
        class="lg:col-span-1 bg-neutral-900 hover:bg-neutral-800 rounded-3xl p-6 border border-neutral-800 hover:border-[#0A66C2]/30 flex flex-col items-center justify-center transition active:scale-[0.99] group block decoration-none text-current"
      >
        <span class="text-2xl mb-2" aria-hidden="true">
          💼
        </span>
        <span class="text-sm font-semibold text-neutral-200 group-hover:text-[#0A66C2]">
          LinkedIn
        </span>
      </a>

      <a
        href="/CV_Miller_Arias.pdf"
        download
        class="md:col-span-1 lg:col-span-2 bg-neutral-900 hover:bg-cyan-500/10 rounded-3xl p-6 border border-neutral-800 hover:border-cyan-500/50 flex items-center justify-center gap-3 transition active:scale-[0.99] group block decoration-none text-current"
      >
        <div class="text-left">
          <span class="block text-sm font-bold text-neutral-200 group-hover:text-cyan-400 transition-colors">
            Descargar Currículum
          </span>
          <span class="text-xs font-mono text-neutral-500">Formato PDF</span>
        </div>
        <span class="bg-neutral-950 p-2 rounded-full text-cyan-400 group-hover:scale-110 transition-transform">
          ↓
        </span>
      </a>
    </div>
  </main>
</Layout>
