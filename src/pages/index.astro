---
import Layout from "../layouts/Layout.astro";
import BentoCard from "../components/BentoCard.astro";
import { profile } from "../data/profile";
import { experiences } from "../data/experience";
import { education } from "../data/education";
import { projectCards, badgeAccent } from "../data/projects";

const currentJob = experiences[0];
---

<Layout
  title="Miller Arias | Software Engineer"
  description="Portafolio profesional de Miller Arias, Electronic Engineer y Full Stack Developer especializado en React, GraphQL y Go. Con sede en Bogotá, Colombia."
  bodyClass="bg-neutral-950 text-neutral-50 min-h-dvh p-6 md:p-12 font-sans selection:bg-cyan-500 selection:text-white"
>
  <main class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 auto-rows-[minmax(180px,auto)] md:auto-rows-[minmax(240px,auto)]">
      <article class="md:col-span-2 md:row-span-2 lg:col-span-2 lg:row-span-2 bg-neutral-900 rounded-3xl p-8 border border-neutral-800 flex flex-col justify-center">
        <p class="text-cyan-400 font-mono text-sm mb-4">Hola, soy</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 tracking-tight">
          {profile.name}
        </h1>
        <p class="text-neutral-400 text-lg md:text-xl leading-relaxed">
          {profile.tagline}
        </p>
      </article>

      <BentoCard
        href="/experiencia/devup"
        transitionName="card-status"
        class="p-6 pt-14 flex flex-col justify-center items-center text-center relative overflow-hidden hover:border-neutral-700"
      >
        <div class="absolute top-4 right-4 flex items-center gap-2 bg-neutral-950/50 px-3 py-1 rounded-full border border-neutral-800 max-w-[calc(100%-2rem)]">
          <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
            <span class="animate-ping-slow absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          <span class="text-[10px] font-mono text-neutral-400 uppercase tracking-wider truncate">
            {profile.availability}
          </span>
        </div>
        <h2 class="text-sm font-mono text-neutral-500 uppercase tracking-wider mb-2">
          Status
        </h2>
        <p class="text-base font-semibold text-neutral-200 px-2">
          {profile.role} en {profile.company}
        </p>
        <p class="text-xs text-neutral-500 mt-2 flex items-center gap-1">
          <span aria-hidden="true">📍</span> {profile.location}
        </p>
      </BentoCard>

      <BentoCard
        href="/contacto"
        transitionName="card-contacto"
        class="flex flex-col justify-center items-center hover:bg-neutral-800/50 hover:border-cyan-500/30"
      >
        <h2 class="text-2xl font-bold mb-2 text-neutral-200">Contacto</h2>
        <p class="text-neutral-400 group-hover:text-cyan-400 transition-colors text-sm font-medium">
          ¿Escribimos código? →
        </p>
      </BentoCard>

      <BentoCard
        href="/educacion"
        transitionName="card-educacion"
        class="md:col-span-1 lg:col-span-2 flex flex-col justify-center hover:border-neutral-700"
      >
        <h2 class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-4 group-hover:text-cyan-300 transition-colors">
          Educación & Certificaciones →
        </h2>
        <div class="space-y-4">
          <div>
            <div class="flex justify-between items-start gap-2">
              <h3 class="text-sm font-semibold text-neutral-200">
                {education[0].title}
              </h3>
              <span class="text-[11px] bg-neutral-800 px-2 py-0.5 rounded text-neutral-400 font-mono shrink-0 whitespace-nowrap">
                {education[0].date}
              </span>
            </div>
            <p class="text-xs text-neutral-500">{education[0].institution}</p>
          </div>
        </div>
      </BentoCard>

      <BentoCard
        href="/experiencia"
        transitionName="card-experiencia"
        class="md:col-span-3 lg:col-span-4 p-6 md:p-8 hover:border-cyan-500/30 relative flex flex-col justify-center"
      >
        <div class="absolute top-6 right-6 md:top-8 md:right-8 opacity-0 group-hover:opacity-100 group-hover:translate-y-0 translate-y-1 transition duration-200 hidden md:block">
          <span class="bg-neutral-800 text-cyan-400 text-xs px-3 py-1 rounded-full flex items-center gap-2">
            Ver historial completo <span class="text-lg">↗</span>
          </span>
        </div>
        <h2 class="text-2xl font-bold mb-6 text-neutral-200">
          Experiencia Laboral
        </h2>
        <div class="border-l-2 border-neutral-800 pl-4 md:pl-6 relative">
          <div class="absolute w-3 h-3 bg-cyan-500 rounded-full -left-[7px] top-1.5 shadow-[0_0_10px_rgba(6,182,212,0.5)]"></div>
          <div class="flex flex-col md:flex-row md:items-baseline gap-1 md:gap-4 mb-1">
            <h3 class="text-xl font-semibold text-neutral-100">
              {currentJob.role}
            </h3>
            <span class="text-neutral-500 text-sm font-mono">
              {currentJob.period}
            </span>
          </div>
          <p class="text-cyan-400 text-sm mb-3 font-medium break-words">
            {currentJob.company}
          </p>
          <p class="text-neutral-400 text-sm md:text-base leading-relaxed line-clamp-2">
            Desarrollo en plataforma open-source de telecomunicaciones.
            Implementación de servicios backend en <strong>Go</strong> y
            frontend en <strong>React</strong>.
          </p>
        </div>
      </BentoCard>

      {projectCards.map((project) => (
        <BentoCard
          href={project.href}
          transitionName={project.transitionName}
          class={`${project.span} flex flex-col justify-between hover:border-neutral-700`}
        >
          <div>
            <div class="flex justify-between items-start mb-2 gap-2">
              <h2 class="text-xl font-bold text-neutral-100 break-words">
                {project.title}
              </h2>
              <span
                class:list={[
                  "text-[11px] font-mono border px-2 py-0.5 rounded-full shrink-0 whitespace-nowrap",
                  badgeAccent[project.tagAccent],
                ]}
              >
                {project.tag}
              </span>
            </div>
            <p class="text-neutral-400 text-sm leading-relaxed line-clamp-3 overflow-wrap-anywhere">
              {project.description}
            </p>
          </div>
          <div class="flex gap-1.5 flex-wrap mt-4">
            {project.stack.map((tech) => (
              <span class="px-2.5 py-0.5 bg-neutral-800 rounded-md text-[11px] text-neutral-300 font-mono">
                {tech}
              </span>
            ))}
          </div>
        </BentoCard>
      ))}

      <article class="md:col-span-2 lg:col-span-2 bg-neutral-900 rounded-3xl p-6 border border-neutral-800 flex flex-col justify-center">
        <h2 class="text-xs font-mono text-neutral-500 uppercase tracking-wider mb-3">
          Tech Stack más usado
        </h2>
        <div class="flex flex-wrap gap-2">
          {profile.techStack.map((tech) => (
            <span class="px-3 py-1 bg-neutral-950 border border-neutral-800 rounded-full text-xs text-neutral-200 font-medium">
              {tech}
            </span>
          ))}
        </div>
      </article>

      <article class="md:col-span-1 lg:col-span-2 bg-neutral-900 rounded-3xl p-6 border border-neutral-800 flex flex-col justify-center">
        <h2 class="text-xs font-mono text-neutral-500 uppercase tracking-wider mb-3">
          Idiomas
        </h2>
        <div class="grid grid-cols-3 gap-2 text-center text-xs font-mono">
          {profile.languages.map((lang) => (
            <div class="bg-neutral-950 p-2 rounded-xl border border-neutral-800/40">
              <span
                class:list={[
                  "block font-semibold",
                  lang.accent ? "text-cyan-400" : "text-neutral-200",
                ]}
              >
                {lang.name}
              </span>
              <span class="text-[11px] text-neutral-500">{lang.level}</span>
            </div>
          ))}
        </div>
      </article>

      <BentoCard
        href={profile.github}
        external
        class="lg:col-span-1 flex flex-col items-center justify-center hover:bg-neutral-800"
      >
        <span class="text-2xl mb-2" aria-hidden="true">
          🐙
        </span>
        <span class="text-sm font-semibold text-neutral-200 group-hover:text-white">
          GitHub
        </span>
      </BentoCard>

      <BentoCard
        href={profile.linkedin}
        external
        class="lg:col-span-1 flex flex-col items-center justify-center hover:bg-neutral-800 hover:border-[#0A66C2]/30"
      >
        <span class="text-2xl mb-2" aria-hidden="true">
          💼
        </span>
        <span class="text-sm font-semibold text-neutral-200 group-hover:text-[#0A66C2]">
          LinkedIn
        </span>
      </BentoCard>

      <BentoCard
        href={profile.cvPath}
        download
        class="md:col-span-1 lg:col-span-2 flex items-center justify-center gap-3 hover:bg-cyan-500/10 hover:border-cyan-500/50"
      >
        <div class="text-left">
          <span class="block text-sm font-bold text-neutral-200 group-hover:text-cyan-400 transition-colors">
            Descargar Currículum
          </span>
          <span class="text-xs font-mono text-neutral-500">Formato PDF</span>
        </div>
        <span class="bg-neutral-950 p-2 rounded-full text-cyan-400 group-hover:scale-110 transition-transform">
          ↓
        </span>
      </BentoCard>
    </div>
  </main>
</Layout>
