---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Educación & Certificaciones | Miller Arias">
  <main class="max-w-3xl mx-auto container-layout">
    <!-- Botón de retorno -->
    <a
      href="/"
      class="back-btn inline-flex items-center gap-2 text-sm font-mono text-neutral-500 hover:text-cyan-400 transition-colors group"
    >
      <span class="inline-block transform group-hover:-translate-x-1 transition-transform">
        ←
      </span>
      Volver al inicio
    </a>

    <!-- CABECERA DE LA PÁGINA -->
    <header
      class="bg-neutral-900 rounded-3xl p-8 md:p-12 border border-neutral-800 shadow-2xl main-header"
      transition:name="card-educacion"
    >
      <div class="flex items-center gap-3 mb-4">
        <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono rounded-full uppercase tracking-wider">
          Formación Continua
        </span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-neutral-100 mb-6">
        Educación & Credenciales
      </h1>
      <p class="text-neutral-400 text-base md:text-lg leading-relaxed">
        Mi base académica en ingeniería combinada con una especialización
        constante en desarrollo de software y tecnologías modernas.
      </p>
    </header>

    <!-- SECCIÓN 1: EDUCACIÓN FORMAL Y CARRERAS PRINCIPALES -->
    <div class="education-list">
      <!-- UNIVERSIDAD NACIONAL -->
      <article class="edu-card">
        <div class="edu-header">
          <div class="edu-title-row">
            <h2 class="text-xl md:text-2xl font-bold text-neutral-100 tracking-tight">
              Ingeniería Electrónica
            </h2>
            <span class="edu-date font-mono text-neutral-500 text-sm">
              2016 — 2024
            </span>
          </div>
          <p class="text-cyan-400 text-sm md:text-base font-medium mt-1">
            Universidad Nacional de Colombia{" "}
            <span class="text-neutral-600 font-normal hidden md:inline-block ml-2">
              • Énfasis en Robótica y Mecatrónica
            </span>
          </p>
        </div>
        <p class="text-neutral-400 text-sm md:text-base leading-relaxed mt-4">
          Formación analítica y profunda basada en la resolución de problemas
          complejos, automatización, diseño de hardware y fundamentos de
          ciencias de la computación.
        </p>
      </article>

      <!-- PLATZI & ALURA SPECIALIZATIONS -->
      <article class="edu-card">
        <div class="edu-header">
          <div class="edu-title-row">
            <h2 class="text-xl md:text-2xl font-bold text-neutral-100 tracking-tight">
              Especializaciones Full Stack & Front End
            </h2>
            <span class="edu-date font-mono text-neutral-500 text-sm">
              2022 — 2023
            </span>
          </div>
          <p class="text-emerald-400 text-sm md:text-base font-medium mt-1">
            Plataformas Tecnológicas{" "}
            <span class="text-neutral-600 font-normal hidden md:inline-block ml-2">
              • Platzi & Alura Latam
            </span>
          </p>
        </div>
        <p class="text-neutral-400 text-sm md:text-base leading-relaxed mt-4">
          Rutas formativas de nivel profesional enfocadas en ecosistemas
          modernos de desarrollo web, arquitectura de software basada en
          JavaScript (Next.js, React, Node.js) y flujos DevOps (Docker).
        </p>
      </article>

      <!-- IDIOMAS -->
      <article class="edu-card">
        <div class="edu-header">
          <div class="edu-title-row">
            <h2 class="text-xl md:text-2xl font-bold text-neutral-100 tracking-tight">
              Aptitud Profesional de Inglés (C1)
            </h2>
            <span class="edu-date font-mono text-neutral-500 text-sm">
              Certificado
            </span>
          </div>
          <p class="text-purple-400 text-sm md:text-base font-medium mt-1">
            Centro Colombo Americano Bogotá{" "}
            <span class="text-neutral-600 font-normal hidden md:inline-block ml-2">
              • Dominio Avanzado
            </span>
          </p>
        </div>
      </article>
    </div>

    <!-- SECCIÓN 2: EL HUB DE LAS 100+ CERTIFICACIONES -->
    <section class="certifications-hub-section">
      <div class="border-b border-neutral-800 pb-4 mb-8">
        <h2 class="text-2xl font-bold text-neutral-100 tracking-tight flex items-center gap-3">
          Licencias y Micro-credenciales
          <span class="text-xs font-mono font-normal bg-neutral-900 text-neutral-400 px-2 py-0.5 border border-neutral-800 rounded">
            +100 cursos
          </span>
        </h2>
        <p class="text-sm text-neutral-500 mt-1">
          Especializaciones atómicas agrupadas por ecosistema de ingeniería.
        </p>
      </div>

      <!-- Tarjetas compactas por categoría de conocimientos -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-neutral-900/40 border border-neutral-900 p-5 rounded-2xl">
          <h3 class="text-sm font-mono text-cyan-400 uppercase tracking-wider mb-2">
            Backend & Logic
          </h3>
          <p class="text-neutral-200 font-medium text-base mb-1">
            Python, Go, C# y Arquitectura
          </p>
          <p class="text-xs text-neutral-500">
            Manejo avanzado de estructuras de datos, lógica orientada a objetos
            y algoritmos eficientes.
          </p>
        </div>

        <div class="bg-neutral-900/40 border border-neutral-900 p-5 rounded-2xl">
          <h3 class="text-sm font-mono text-emerald-400 uppercase tracking-wider mb-2">
            Frontend Systems
          </h3>
          <p class="text-neutral-200 font-medium text-base mb-1">
            React, Next.js, Relay & UI
          </p>
          <p class="text-xs text-neutral-500">
            Construcción de interfaces interactivas, renderizado del lado del
            servidor y consumo óptimo de datos.
          </p>
        </div>

        <div class="bg-neutral-900/40 border border-neutral-900 p-5 rounded-2xl">
          <h3 class="text-sm font-mono text-purple-400 uppercase tracking-wider mb-2">
            Data & Storage
          </h3>
          <p class="text-neutral-200 font-medium text-base mb-1">
            SQL, MySQL & GraphQL
          </p>
          <p class="text-xs text-neutral-500">
            Diseño de bases de datos relacionales, optimización de queries
            complejas y modelado de datos.
          </p>
        </div>

        <div class="bg-neutral-900/40 border border-neutral-900 p-5 rounded-2xl">
          <h3 class="text-sm font-mono text-neutral-400 uppercase tracking-wider mb-2">
            AI & Hardware
          </h3>
          <p class="text-neutral-200 font-medium text-base mb-1">
            Modelos de IA, IoT y Robótica
          </p>
          <p class="text-xs text-neutral-500">
            Automatización de captura de información clínica y flujos
            inteligentes aplicados al negocio.
          </p>
        </div>
      </div>

      <!-- ACCORDION / TOGGLE MINIMALISTA PARA VER DETALLES SIN SATURAR -->
      <div class="mt-12 text-center">
        <button
          id="toggle-certs-btn"
          aria-expanded="false"
          aria-controls="hidden-certs-panel"
          class="inline-flex items-center gap-2 text-sm font-mono text-neutral-400 hover:text-cyan-400 border border-neutral-800 bg-neutral-900/50 hover:bg-neutral-900 px-5 py-3 rounded-full transition active:scale-[0.99]"
        >
          <span>Mostrar cursos destacados</span>
          <svg
            id="arrow-icon"
            class="w-3 h-3 transform transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M19 9l-7 7-7-7"
            />
          </svg>
        </button>
      </div>

      <!-- PANEL OCULTO: Solo se despliega al dar click -->
      <div id="hidden-certs-panel" class="hidden-panel mt-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm font-mono text-neutral-400 bg-neutral-900/20 p-6 rounded-2xl border border-neutral-900">
          <div class="flex items-center gap-2 text-neutral-300">
            ✓ Python: Comprehensions & Errores
          </div>
          <div class="flex items-center gap-2 text-neutral-300">
            ✓ Curso Práctico de SQL y MySQL
          </div>
          <div>✓ Algoritmia y Estructuras de Datos</div>
          <div>✓ Programación Asíncrona con JS</div>
          <div>✓ Git y GitHub Avanzado</div>
          <div>✓ React.js & Manejo de Estado Profesional</div>
          <div>✓ Diseño de Arquitectura de Software</div>
          <div>✓ Estrategias de Optimización en Bases de Datos</div>
          <div>✓ Introducción Práctica a Modelos de IA</div>
          <div>✓ Unity 2D/3D Engine Core</div>
          <div class="sm:col-span-2 text-center pt-4 text-xs text-neutral-500 italic border-t border-neutral-900 mt-2">
            ... y más de 90 credenciales verificables en mis perfiles de Platzi
            y LinkedIn.
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="main-footer-bottom text-center">
      <p class="text-xs font-mono text-neutral-500">
        Miller Arias • Portafolio Profesional 2026
      </p>
    </footer>
  </main>

  <script is:inline>
    document.addEventListener("astro:page-load", () => {
      const btn = document.getElementById("toggle-certs-btn");
      const panel = document.getElementById("hidden-certs-panel");
      const arrow = document.getElementById("arrow-icon");
      const label = btn ? btn.querySelector("span") : null;
      if (!btn || !panel || !arrow || !label || btn.dataset.bound) return;
      btn.dataset.bound = "true";

      btn.addEventListener("click", () => {
        const isOpen = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!isOpen));
        panel.classList.toggle("open-panel", !isOpen);
        arrow.classList.toggle("rotate-180", !isOpen);
        label.textContent = isOpen
          ? "Mostrar cursos destacados"
          : "Ocultar cursos destacados";
      });
    });
  </script>
</Layout>

<style>
  /* Estructura básica inmutable */
  .container-layout {
    margin-top: 3.5rem;
  }
  .back-btn {
    margin-bottom: 4.5rem !important;
  }
  .main-header {
    margin-bottom: 6rem !important;
  }

  /* Lista de Educación */
  .education-list {
    display: flex;
    flex-direction: column;
    gap: 5rem !important;
    margin-bottom: 8rem;
  }

  .edu-header {
    border-bottom: 1px solid #262626;
    padding-bottom: 1rem;
  }

  .edu-title-row {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .edu-title-row {
      flex-direction: row;
      align-items: baseline;
    }
    .container-layout {
      margin-top: 5rem;
    }
  }

  /* Animación bidireccional del panel de certificados (retargeteable, dentro del presupuesto 300ms) */
  .hidden-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 250ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .hidden-panel > * {
    overflow: hidden;
  }

  .open-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .main-footer-bottom {
    margin-top: 8rem;
    padding-top: 2rem;
    border-top: 1px solid #171717;
  }
</style>
