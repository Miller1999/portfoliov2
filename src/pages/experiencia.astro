---
import Layout from "../layouts/Layout.astro";
import { experiences, accentClasses } from "../data/experience";
---

<Layout
  title="Work Experience | Miller Arias"
  description="Professional career of Miller Arias as a Full Stack Developer: open-source platform development, backend services in Go, and frontend with React and GraphQL."
>
  <main class="max-w-3xl mx-auto mt-14 md:mt-20">
    <a
      href="/"
      class="inline-flex items-center gap-2 py-3 text-sm font-mono text-neutral-500 hover:text-cyan-400 transition-colors group"
    >
      <span class="inline-block group-hover:-translate-x-1 transition-transform">
        ←
      </span>
      Back to home
    </a>

    <header
      transition:name="card-experiencia"
      class="bg-neutral-900 rounded-3xl p-8 md:p-12 border border-neutral-800 mt-14 mb-24"
    >
      <div class="flex items-center gap-3 mb-4">
        <span class="px-3 py-1 bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono rounded-full uppercase tracking-wider">
          Professional History
        </span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-neutral-100 mb-6">
        Career & Experience
      </h1>
      <p class="text-neutral-400 text-base md:text-lg leading-relaxed">
        Electronic Engineer and Full Stack Developer focused on building
        maintainable, scalable, and well-structured software. My technical
        journey and the challenges overcome in each role.
      </p>
    </header>

    <div class="flex flex-col gap-28">
      {experiences.map((job) => {
        const accent = accentClasses[job.accent];
        return (
          <article>
            <div class="border-b border-neutral-800 pb-5 mb-8">
              <div class="flex flex-col justify-between items-start gap-2 md:flex-row md:items-baseline">
                <h2 class="text-2xl md:text-3xl font-bold text-neutral-100 tracking-tight">
                  {job.role}
                </h2>
                <span class="font-mono text-neutral-500 text-sm shrink-0">
                  {job.period}
                </span>
              </div>
              <p class:list={["text-base font-medium mt-1", accent.company]}>
                {job.company}{" "}
                <span class="text-neutral-600 font-normal hidden md:inline-block ml-2">
                  • {job.sector}
                </span>
              </p>
              <p class="text-neutral-600 text-sm font-normal md:hidden mt-0.5">
                {job.sector}
              </p>
            </div>

            <p class="text-neutral-400 text-base md:text-lg leading-relaxed mb-8">
              {job.summary}
            </p>

            <ul class="flex flex-col gap-5 mb-10 pl-1">
              {job.achievements.map((item) => (
                <li class="flex items-start gap-3">
                  <span
                    class:list={["mt-0.5 font-bold shrink-0", accent.bullet]}
                    aria-hidden="true"
                  >
                    ―
                  </span>
                  <span
                    class="text-neutral-300 text-sm md:text-base"
                    set:html={item}
                  />
                </li>
              ))}
            </ul>

            <div class="flex flex-wrap gap-3 mt-8">
              {job.stack.map((tech) => (
                <span class="text-xs font-mono text-neutral-500 bg-neutral-900/60 border border-neutral-800/40 px-3 py-1 rounded inline-block">
                  {tech}
                </span>
              ))}
            </div>
          </article>
        );
      })}
    </div>

    <footer class="mt-32 pt-8 border-t border-neutral-800 text-center">
      <p class="text-xs font-mono text-neutral-500">
        Miller Arias • Professional Portfolio 2026
      </p>
    </footer>
  </main>
</Layout>
